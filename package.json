{
  "name": "low-vision-workspace-profiles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "build": "node scripts/build.mjs",
    "build:extension": "wxt build",
    "build:site": "vite build --config site/vite.config.ts",
    "test": "vitest run",
    "test:browser": "npm run build:extension && xvfb-run -a playwright test",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.58.2",
    "@types/chrome": "^0.0.322",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wxt": "^0.21.4"
  }
}
